{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDirs": [
            "."
        ],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noImplicitAny": true
    },
    "include": [
        "**/*.ts",
        "src/**/*.ts",
        "knexfile.d.ts",
        "knexfile.js",
        "src/db/migrations/*.js"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}